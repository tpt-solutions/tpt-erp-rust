# TPT ERP RUST — environment variable reference
#
# Copy to `.env` and adjust. Every variable is optional unless noted; the binaries
# fall back to sane in-memory/local defaults so you can run a single example without
# standing up infrastructure.

# ---------------------------------------------------------------------------
# Server / runtime
# ---------------------------------------------------------------------------

# Address the Axum server binds to (reference `server` example).
TPT_BIND=127.0.0.1:3000

# Log level for the `tracing` subscriber (error | warn | info | debug | trace).
RUST_LOG=info

# If set (non-empty), the reference server ENFORCES JWT (HS256) auth and resolves
# the tenant from the verified token's `tenant` claim. If unset, it falls back to
# the dev-only header/subdomain tenant resolution. REQUIRED for any real deployment.
# Generate one with: tpt token mint --secret "$TPT_JWT_SECRET" --tenant acme
TPT_JWT_SECRET=

# ---------------------------------------------------------------------------
# PostgreSQL (used by tpt-erp-ledger Postgres mirror, tpt-erp-entity
# PostgresRepository, and tpt-erp-tenant RLS)
# ---------------------------------------------------------------------------

TPT_DATABASE_URL=postgres://tpt:tpt@localhost:5432/tpt

# Postgres URL used by `#[cfg(test)]` integration tests that need a real DB.
# When unset, those tests are skipped.
TPT_TEST_POSTGRES_URL=postgres://tpt:tpt@localhost:5432/tpt

# ---------------------------------------------------------------------------
# NATS JetStream (tpt-erp-bus event processing / background jobs)
# ---------------------------------------------------------------------------

TPT_BUS_URL=nats://localhost:4222

# Optional stream name for durable consumers.
TPT_NATS_STREAM=tpt

# ---------------------------------------------------------------------------
# Redis / Dragonfly (tpt-erp-cache session store + read-model cache)
# ---------------------------------------------------------------------------

TPT_CACHE_URL=redis://localhost:6379
